# Google Gemini (API key depuis Google AI Studio)
GEMINI_API_KEY=votre_cle_api_gemini

# PostgreSQL (mémoire de conversation)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=votre_base
POSTGRES_USER=votre_utilisateur
POSTGRES_PASSWORD=votre_mot_de_passe

# Google (OAuth2 configuré dans n8n pour Gmail et Sheets)
GOOGLE_SHEET_ID=votre_id_google_sheet

# Boutique
WHATSAPP_NUMBER=votre_numero_whatsapp
